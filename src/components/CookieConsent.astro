---
// src/components/CookieConsent.astro
const META_PIXEL_ID = "1618991029125752";
const GOOGLE_TAG_ID = "AW-17869883884";
---

<div id="cookie-banner" class="fixed bottom-0 left-0 right-0 bg-black border-t border-white/20 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.3)] p-4 md:p-6 z-50 hidden flex-col md:flex-row items-center justify-between gap-4 transition-transform duration-300 translate-y-full">
  <div class="text-sm text-white max-w-6xl">
    <p class="font-bold mb-1">Käytämme evästeitä 🍪</p>
    <p>
      Käytämme sivustolla välttämättömiä evästeitä sekä markkinointievästeitä mainonnan kohdentamiseen.

      <a href="/tietosuoja" class="underline hover:opacity-90 transition-opacity" style="color: #d27ea0;">Lue tietosuojaseloste ja käyttöehdot.</a>
    </p>
  </div>
  <div class="flex gap-4 shrink-0 my-3">
    <button id="cookie-reject" class="px-4 py-2 text-sm font-medium text-white bg-white/10 hover:bg-white/20 rounded-lg transition-colors">
      Vain välttämättömät
    </button>
    <button id="cookie-accept" class="px-4 py-2 text-sm font-medium text-white rounded-lg shadow-sm transition-colors hover:opacity-90" style="background-color: #d27ea0;">
      Hyväksy kaikki
    </button>
  </div>
</div>

<script is:inline define:vars={{ META_PIXEL_ID, GOOGLE_TAG_ID }}>
  // 1. Määritellään funktio, joka lataa Meta Pixelin
  function loadMetaPixel() {
    console.log("Meta Pixel loaded with Consent ✅");
    
    // Meta Pixel Base Code
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/fi_FI/fbevents.js');  
    
    fbq('init', META_PIXEL_ID);
    fbq('track', 'PageView');
  }

  // 2. Määritellään funktio, joka lataa Google Tagin
  function loadGoogleTag() {
    console.log("Google Tag loaded with Consent ✅");
    
    // Lataa script-tagi
    const script = document.createElement('script');
    script.src = `https://www.googletagmanager.com/gtag/js?id=${GOOGLE_TAG_ID}`;
    script.async = true;
    document.head.appendChild(script);

    // Alusta gtag
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', GOOGLE_TAG_ID);
  }

  // 3. Tarkistetaan onko lupa jo annettu
  const banner = document.getElementById('cookie-banner');
  const acceptBtn = document.getElementById('cookie-accept');
  const rejectBtn = document.getElementById('cookie-reject');

  const consent = localStorage.getItem('cookie-consent');

  if (consent === 'granted') {
    // Jos lupa on jo, ladataan Pixel heti
    loadMetaPixel();
    loadGoogleTag();
  } else if (consent === 'denied') {
    // Jos kielletty, ei tehdä mitään (Pixel ei lataudu)
  } else {
    // Jos ei valintaa, näytetään banneri pienellä viiveellä (tyylikäs slide-in)
    banner.classList.remove('hidden');
    setTimeout(() => {
      banner.classList.remove('translate-y-full');
    }, 100);
  }

  // 3. Napinkäsittelijät
  acceptBtn.addEventListener('click', () => {
    localStorage.setItem('cookie-consent', 'granted');
    loadMetaPixel(); // Käynnistä Pixel heti
    loadGoogleTag(); // Käynnistä Google Tag heti
    hideBanner();
  });

  rejectBtn.addEventListener('click', () => {
    localStorage.setItem('cookie-consent', 'denied');
    // Ei ladata Pixeliä
    hideBanner();
  });

  function hideBanner() {
    banner.classList.add('translate-y-full');
    setTimeout(() => {
      banner.classList.add('hidden');
    }, 300);
  }
</script>

<noscript>
  <img
    height="1"
    width="1"
    style="display:none"
    src="https://www.facebook.com/tr?id=1618991029125752&ev=PageView&noscript=1"
    alt=""
  />
</noscript>