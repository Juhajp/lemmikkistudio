---
import Layout from '../layouts/layout.astro';
import FeedbackForm from '../components/FeedbackForm';
---

<Layout
  title="Palaute | Lemmikkistudio"
  description="Jätä palautetta Lemmikkistudio-palvelusta."
  noindex={true}
>
  <main class="min-h-screen py-12 px-4 sm:px-6 lg:px-8 bg-gray-50">
    <div class="max-w-xl mx-auto bg-white p-8 rounded-xl shadow-sm">
      <div class="mb-8 border-b pb-6">
        <h1 class="text-3xl font-bold text-gray-900">Palaute</h1>
        <p class="text-gray-600 mt-2">
          Kerro kokemuksestasi – palautteesi auttaa meitä kehittämään palvelua.
        </p>
      </div>

      <FeedbackForm client:load />
    </div>
  </main>
</Layout>
